<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Uygulama teması: Koçan (açık, yüksek kontrast). Yalnız platform teması; appcompat kullanılmaz.
         Sistem çubuklarının rengi kodda enableEdgeToEdge ile verilir. -->
    <style name="Tema.TerziTakip" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/tk_ac</item>
        <item name="android:colorAccent">@color/tk_ac</item>
        <item name="android:colorControlActivated">@color/tk_ac</item>
        <item name="android:windowBackground">@color/tk_bg</item>
        <item name="android:textColorPrimary">@color/tk_tx</item>
        <item name="android:textColorSecondary">@color/tk_mut</item>
    </style>

    <!-- Android 12 SplashScreen API (core-splashscreen ile Android 8-11'de de aynı görünüm). -->
    <style name="Tema.TerziTakip.Acilis" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/simge_zemin</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Tema.TerziTakip</item>
    </style>

    <style name="Tema.TerziTakip.Kamera" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="TkBaslik">
        <item name="android:textColor">@color/tk_tx</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TkMetin">
        <item name="android:textColor">@color/tk_tx</item>
        <item name="android:textSize">18sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="TkEtiket" parent="TkMetin">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TkGirdi">
        <item name="android:background">@drawable/tk_girdi</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/tk_tx</item>
        <item name="android:textColorHint">@color/tk_mut</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TkDugme">
        <item name="android:background">@drawable/tk_dugme</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/tk_tx</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="TkDugme.Ana">
        <item name="android:background">@drawable/tk_dugme_ana</item>
        <item name="android:textColor">@color/tk_ac_fg</item>
    </style>
</resources>
