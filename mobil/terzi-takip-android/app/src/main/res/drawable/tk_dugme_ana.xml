<?xml version="1.0" encoding="utf-8"?>
<!-- Koçan düğmesi: 2dp kenar, 4dp köşe, 4dp sert gölge (tema.css: tk-gol jetonu). Basılıyken gölge kalkar. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="3dp" android:top="3dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tk_ac" />
                    <stroke android:width="2dp" android:color="@color/tk_line" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_enabled="false">
        <layer-list>
            <item android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tk_panel2" />
                    <stroke android:width="2dp" android:color="@color/tk_mut" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tk_line" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <item android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tk_ac" />
                    <stroke android:width="2dp" android:color="@color/tk_line" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
