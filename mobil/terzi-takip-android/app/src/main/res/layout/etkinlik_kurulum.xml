<?xml version="1.0" encoding="utf-8"?>
<!-- İlk kurulum ve Sunucu ayarı (gizli menü): sunucu adresi + eşleştirme kodu, karekoddan otomatik doldurma. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tk_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:src="@drawable/yaka" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/uygulama_adi"
                android:textColor="@color/tk_tx"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/TkBaslik"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/kurulum_baslik" />

        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/imza_cizgi" />

        <TextView
            style="@style/TkMetin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/kurulum_aciklama" />

        <Button
            android:id="@+id/karekod"
            style="@style/TkDugme.Ana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/karekodu_oku" />

        <TextView
            style="@style/TkEtiket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@+id/adres"
            android:text="@string/sunucu_adresi" />

        <EditText
            android:id="@+id/adres"
            style="@style/TkGirdi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/sunucu_ipucu"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1" />

        <TextView
            style="@style/TkEtiket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@+id/kod"
            android:text="@string/eslestirme_kodu" />

        <EditText
            android:id="@+id/kod"
            style="@style/TkGirdi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:hint="······"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="6"
            android:maxLines="1" />

        <TextView
            android:id="@+id/mesaj"
            style="@style/TkMetin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/tk_hata"
            android:visibility="gone" />

        <Button
            android:id="@+id/kaydet"
            style="@style/TkDugme.Ana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/kaydet_baglan" />

        <Button
            android:id="@+id/vazgec"
            style="@style/TkDugme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/vazgec"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ayar_not"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ayar_not"
            android:textColor="@color/tk_mut"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/surum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/tk_mut"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
